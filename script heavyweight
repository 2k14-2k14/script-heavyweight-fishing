-- ============ FIX LAG ============
local fixLagConn = nil

local function applyFixLag(obj)
    pcall(function()
        if obj:IsA("ParticleEmitter")
            or obj:IsA("Trail")
            or obj:IsA("Smoke")
            or obj:IsA("Fire")
            or obj:IsA("Sparkles")
            or obj:IsA("Light")
            or obj:IsA("Beam")
        then
            obj.Enabled = false
        elseif obj:IsA("Decal") or obj:IsA("Texture") then
            obj.Transparency = 1
        elseif obj:IsA("Explosion") then
            obj.BlastPressure = 0
            obj.BlastRadius = 0
        elseif obj:IsA("Sound") then
            obj.Volume = 0
        end
    end)
end

local function enableFixLag()
    -- Quét toàn bộ hiện tại
    for _, v in ipairs(game:GetDescendants()) do
        applyFixLag(v)
    end

    -- Giảm chất lượng đồ họa
    pcall(function()
        settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
        Lighting.GlobalShadows = false
        Lighting.FogEnd = 1e10
        Lighting.Brightness = 2
        for _, v in ipairs(Lighting:GetChildren()) do
            if v:IsA("PostEffect") or v:IsA("Atmosphere") or v:IsA("Sky") then
                v.Enabled = false
            end
        end
    end)

    -- Bắt các object mới spawn
    fixLagConn = game.DescendantAdded:Connect(applyFixLag)
end

local function disableFixLag()
    if fixLagConn then
        fixLagConn:Disconnect()
        fixLagConn = nil
    end
end

LagBtn.MouseButton1Click:Connect(function()
    getgenv().NWKZ_FixLag = not getgenv().NWKZ_FixLag
    LagBtn.Text = "FIX LAG: " .. (getgenv().NWKZ_FixLag and "ON" or "OFF")
    LagBtn.BackgroundColor3 = getgenv().NWKZ_FixLag and Color3.fromRGB(0, 150, 80) or Color3.fromRGB(120, 80, 0)

    if getgenv().NWKZ_FixLag then
        enableFixLag()
    else
        disableFixLag()
    end
end)

-- ============ AUTO CAST ============
task.spawn(function()
    while task.wait(1) do
        if getgenv().NWKZ_AutoCast then
            pcall(function()
                local char = lp.Character
                if char and not char:GetAttribute("Fishing") and not MainGui.Fishing.Visible then
                    RS.Events.Fishing:FireServer()
                end
            end)
        end
    end
end)

